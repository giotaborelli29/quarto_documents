library(readxl)
DATA <- read_excel("Sara_dataset.xls")
summary(DATA)
cor_pre <- cor(DATA$anx_pre, DATA$mathquiz, use = "complete.obs")
cor_pre
rm(cor_pre)
mean_post <- mean(DATA$anx_post)
